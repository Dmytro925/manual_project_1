# Copy this file to .env and fill in the values for your environment
# (Dev, QA, Prod). .env is gitignored, never commit real secrets.

# Base URL of the web application under test (used by Playwright for relative paths)
BASE_URL=https://your-app-url.example.com

# Base URL of the API (falls back to BASE_URL when empty)
API_BASE_URL=https://your-api-url.example.com

# Test user credentials
STANDARD_USER_USERNAME=your-standard-username
STANDARD_USER_PASSWORD=your-standard-password

LOCKED_USER_USERNAME=your-locked-username
LOCKED_USER_PASSWORD=your-locked-password

# {date} is replaced with the current date (DDMMYYYY) at login
ADMIN_USER_USERNAME=your-admin-username
ADMIN_USER_PASSWORD_TEMPLATE=your-admin-password-prefix{date}
